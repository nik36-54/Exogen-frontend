{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/exogen-risk-intelligence",
    "build": "npm run build --workspace=@workspace/exogen-risk-intelligence",
    "start": "npm run serve --workspace=@workspace/exogen-risk-intelligence",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck --workspace=@workspace/exogen-risk-intelligence",
    "lint": "tsc --noEmit -p ./artifacts/exogen-risk-intelligence/tsconfig.json"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
